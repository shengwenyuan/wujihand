<?xml version="1.0"?>
<package format="3">
  <name>wujihand_ros2</name>
  <version>0.2.0</version>
  <description>ROS 2 Jazzy adapters for Wuji dual teleoperation.</description>
  <maintainer email="maintainers@wujihand.invalid">WujiHand maintainers</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>lifecycle_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>wujihand_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>launch_testing</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
